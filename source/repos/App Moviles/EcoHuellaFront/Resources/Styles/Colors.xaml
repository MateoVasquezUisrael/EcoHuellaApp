<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#18A64F</Color>
    <Color x:Key="PrimaryDark">#007A37</Color>
    <Color x:Key="PrimaryDarkText">#0D1F1A</Color>
    <Color x:Key="Secondary">#B9F5CF</Color>
    <Color x:Key="SecondaryDarkText">#008A3D</Color>
    <Color x:Key="Tertiary">#F5C32D</Color>

    <Color x:Key="FondoPaginaEco">#F2F2F2</Color>
    <Color x:Key="SuperficieEco">#FFFFFF</Color>
    <Color x:Key="BordeEco">#D8D8D8</Color>
    <Color x:Key="TextoPrincipalEco">#007A37</Color>
    <Color x:Key="TextoSecundarioEco">#008A3D</Color>
    <Color x:Key="BotonPrimarioEco">#18A64F</Color>
    <Color x:Key="BotonSecundarioEco">#B9F5CF</Color>
    <Color x:Key="TextoBotonSecundarioEco">#0D1F1A</Color>
    <Color x:Key="BotonGoogle">#E92529</Color>
    <Color x:Key="BordeCampoFormulario">#73EAD9</Color>
    <Color x:Key="AvatarRegistro">#CDD2D8</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="FondoPaginaEcoBrush" Color="{StaticResource FondoPaginaEco}"/>
    <SolidColorBrush x:Key="SuperficieEcoBrush" Color="{StaticResource SuperficieEco}"/>
    <SolidColorBrush x:Key="BordeEcoBrush" Color="{StaticResource BordeEco}"/>
    <SolidColorBrush x:Key="TextoPrincipalEcoBrush" Color="{StaticResource TextoPrincipalEco}"/>
    <SolidColorBrush x:Key="TextoSecundarioEcoBrush" Color="{StaticResource TextoSecundarioEco}"/>
    <SolidColorBrush x:Key="BotonPrimarioEcoBrush" Color="{StaticResource BotonPrimarioEco}"/>
    <SolidColorBrush x:Key="BotonSecundarioEcoBrush" Color="{StaticResource BotonSecundarioEco}"/>
    <SolidColorBrush x:Key="BotonGoogleBrush" Color="{StaticResource BotonGoogle}"/>
    <SolidColorBrush x:Key="BordeCampoFormularioBrush" Color="{StaticResource BordeCampoFormulario}"/>
    <SolidColorBrush x:Key="AvatarRegistroBrush" Color="{StaticResource AvatarRegistro}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
