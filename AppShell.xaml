<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EcoHuellaApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:EcoHuellaApp.Presentation.Views"
    Title="EcoHuellaApp"
    Shell.NavBarIsVisible="False">

    <TabBar>

        <ShellContent
            Title="Inicio"
            ContentTemplate="{DataTemplate views:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Casas"
            ContentTemplate="{DataTemplate views:CasaView}" />

        <ShellContent
            Title="Puntos de Recolección"
            ContentTemplate="{DataTemplate views:PuntoRecoleccionView}" />

        <ShellContent
            Title="Recolección"
            ContentTemplate="{DataTemplate views:RecoleccionView}" />

        <ShellContent
            Title="Mapa"
            ContentTemplate="{DataTemplate views:MapPage}" />

    </TabBar>

</Shell>