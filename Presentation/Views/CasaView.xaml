<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EcoHuellaApp.Presentation.ViewModels"
             xmlns:models="clr-namespace:EcoHuellaApp.Domain.Models.Recoleccion"
             x:Class="EcoHuellaApp.Presentation.Views.CasaView"
             x:DataType="vm:CasaViewModel"
             Title="CasaView">
    <ScrollView>
        <VerticalStackLayout
        Padding="20"
        Spacing="10">

            <Label
            Text="Gestión de Casas"
            FontSize="24"
            HorizontalOptions="Center" />

            <Entry
            Text="{Binding NombreResponsable}"
            Placeholder="Nombre del responsable" />

            <Entry
            Text="{Binding Direccion}"
            Placeholder="Dirección" />

            <Entry
            Text="{Binding Sector}"
            Placeholder="Sector" />

            <Entry
            Text="{Binding Latitud}"
            Placeholder="Latitud"
            IsReadOnly="True"
            Keyboard="Numeric" />

            <Entry
            Text="{Binding Longitud}"
            Placeholder="Longitud"
            IsReadOnly="True"
            Keyboard="Numeric" />

            <Button
            Text="Seleccionar en mapa"
            Command="{Binding SeleccionarUbicacionCommand}" />

            <HorizontalStackLayout>
                <Label
                Text="Activa"
                VerticalOptions="Center" />

                <Switch
                IsToggled="{Binding Estado}" />
            </HorizontalStackLayout>

            <HorizontalStackLayout
            HorizontalOptions="Center"
            Spacing="10">

                <Button
                Text="Guardar"
                Command="{Binding GuardarCommand}" />

                <Button
                Text="Actualizar"
                Command="{Binding ActualizarCommand}" />

                <Button
                Text="Eliminar"
                Command="{Binding EliminarCommand}" />

                <Button
                Text="Probar Notificación"
                Command="{Binding ProbarNotificacionCommand}"/>

            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               Margin="0,4,0,0"/>

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="#C0392B"
                   FontSize="13"/>

            <CollectionView
            ItemsSource="{Binding Casas}"
            SelectedItem="{Binding CasaSeleccionada}"
            SelectionMode="Single">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Casa">
                        <Frame Margin="5">
                            <VerticalStackLayout>

                                <Label
                                Text="{Binding NombreResponsable}"
                                FontAttributes="Bold" />

                                <Label
                                Text="{Binding Direccion}" />

                                <Label
                                Text="{Binding Sector}" />

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
