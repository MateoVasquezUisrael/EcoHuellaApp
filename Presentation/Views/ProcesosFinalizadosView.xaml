<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.ProcesosFinalizadosView"
             Title="Procesos Finalizados">
    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="10">

            <Label
                Text="Procesos Finalizados"
                FontSize="24"
                HorizontalOptions="Center" />

            <Label
                x:Name="lblFiltro"
                FontSize="14"
                HorizontalOptions="Center" />

            <CollectionView
                x:Name="cvProcesosFinalizados"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#242424}"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#333}"
                                Margin="5"
                                Padding="10">
                            <VerticalStackLayout>

                                <Label
                                    Text="{Binding Id, StringFormat='Proceso #{0}'}"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding BiodigestorId, StringFormat='Biodigestor: #{0}'}" />

                                <Label
                                    Text="{Binding FechaInicio, StringFormat='Inicio: {0:dd/MM/yyyy HH:mm}'}" />

                                <Label
                                    Text="{Binding FechaCierre, StringFormat='Cierre: {0:dd/MM/yyyy HH:mm}'}" />

                                <Label
                                    Text="{Binding MasaRestante, StringFormat='Masa restante: {0:F2} kg'}" />

                                <Label
                                    Text="{Binding MetanoEvitado, StringFormat='Metano evitado: {0:F2} kg'}" />

                                <Label
                                    Text="{Binding CarbonoEvitado, StringFormat='Carbono evitado: {0:F2} kg CO2e'}" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
