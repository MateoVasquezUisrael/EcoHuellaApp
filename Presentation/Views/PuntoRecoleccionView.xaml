<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.PuntoRecoleccionView"
             Title="PuntoRecoleccionView">
    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="10">

            <Label
                Text="Gestión de Puntos de Recolección"
                FontSize="24"
                HorizontalOptions="Center" />

            <Entry
                x:Name="txtDireccion"
                Placeholder="Dirección" />

            <Entry
                x:Name="txtLatitud"
                Placeholder="Latitud"
                IsReadOnly="True"
                Keyboard="Numeric" />

            <Entry
                x:Name="txtLongitud"
                Placeholder="Longitud"
                IsReadOnly="True"
                Keyboard="Numeric" />

            <Button
                x:Name="btnSeleccionarUbicacion"
                Text="Seleccionar en mapa"
                Clicked="btnSeleccionarUbicacion_Clicked" />

            <HorizontalStackLayout>
                <Label
                    Text="Activo"
                    VerticalOptions="Center" />

                <Switch
                    x:Name="swEstado"
                    IsToggled="True" />
            </HorizontalStackLayout>

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="10">

                <Button
                    x:Name="btnGuardar"
                    Text="Guardar"
                    Clicked="btnGuardar_Clicked" />

                <Button
                    x:Name="btnActualizar"
                    Text="Actualizar"
                    Clicked="btnActualizar_Clicked" />

                <Button
                    x:Name="btnEliminar"
                    Text="Eliminar"
                    Clicked="btnEliminar_Clicked" />

            </HorizontalStackLayout>

            <CollectionView
                x:Name="cvPuntosRecoleccion"
                SelectionMode="Single"
                SelectionChanged="cvPuntosRecoleccion_SelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="5">
                            <VerticalStackLayout>

                                <Label
                                    Text="{Binding Direccion}"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Latitud}" />

                                <Label
                                    Text="{Binding Longitud}" />

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
