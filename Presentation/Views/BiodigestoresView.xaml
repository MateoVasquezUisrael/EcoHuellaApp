<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.BiodigestoresView"
             Title="Biodigestores">
    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="10">

            <Label
                Text="Gestión de Biodigestores"
                FontSize="24"
                HorizontalOptions="Center" />

            <Entry
                x:Name="txtCapacidadMaxima"
                Placeholder="Capacidad máxima (kg)"
                Keyboard="Numeric" />

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="10">

                <Button
                    x:Name="btnGuardar"
                    Text="Guardar"
                    Clicked="btnGuardar_Clicked" />

                <Button
                    x:Name="btnActualizar"
                    Text="Actualizar"
                    Clicked="btnActualizar_Clicked" />

                <Button
                    x:Name="btnEliminar"
                    Text="Eliminar"
                    Clicked="btnEliminar_Clicked" />

            </HorizontalStackLayout>

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="10">

                <Button
                    x:Name="btnVerProcesos"
                    Text="Ver Procesos"
                    Clicked="btnVerProcesos_Clicked" />

                <Button
                    x:Name="btnVerFinalizados"
                    Text="Ver Finalizados"
                    Clicked="btnVerFinalizados_Clicked" />

            </HorizontalStackLayout>

            <CollectionView
                x:Name="cvBiodigestores"
                SelectionMode="Single"
                SelectionChanged="cvBiodigestores_SelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#242424}"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#333}"
                                Margin="5"
                                Padding="10">
                            <VerticalStackLayout>

                                <Label
                                    Text="{Binding Id, StringFormat='Biodigestor #{0}'}"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding CapacidadMaxima, StringFormat='Capacidad máxima: {0} kg'}" />

                                <Label
                                    Text="{Binding Estado, StringFormat='Activo: {0}'}" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
