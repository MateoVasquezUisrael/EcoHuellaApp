<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.BiodigestoresView"
             Title="Biodigestores"
             BackgroundColor="{StaticResource BackgroundSoft}">
    <ScrollView>
        <Grid Padding="12" MaximumWidthRequest="430" HorizontalOptions="Center">
            <Border Style="{StaticResource EcoCard}" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <Border Style="{StaticResource EcoHeader}">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="BIODIGESTORES" TextColor="White" FontFamily="OpenSansSemibold" FontSize="22" />
                            <Label Text="Procesos registrados en el sistema" TextColor="#D9FFF1" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Padding="18" Spacing="14">
                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Procesos de biodigestor" Style="{StaticResource EcoTitle}" FontSize="22" />
                                <Label Text="Selecciona un biodigestor registrado para consultar sus procesos activos, entradas y ciclos finalizados." Style="{StaticResource EcoSubtitle}" />
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button x:Name="btnVerProcesos"
                                    Text="Procesos activos"
                                    Clicked="btnVerProcesos_Clicked" />
                            <Button Grid.Column="1"
                                    x:Name="btnVerFinalizados"
                                    Text="Finalizados"
                                    Clicked="btnVerFinalizados_Clicked"
                                    Style="{StaticResource BotonSecundario}" />
                        </Grid>

                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Datos del biodigestor" Style="{StaticResource EcoTitle}" FontSize="22" />

                                <Border Style="{StaticResource CampoFormulario}">
                                    <Entry x:Name="txtCapacidadMaxima" Placeholder="Capacidad máxima (kg)" Keyboard="Numeric" Style="{StaticResource EntradaFormulario}" />
                                </Border>

                                <Border Style="{StaticResource StatusActivo}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Biodigestor activo" TextColor="{StaticResource DeepTeal}" FontFamily="OpenSansSemibold" VerticalTextAlignment="Center" />
                                        <Switch Grid.Column="1" x:Name="swEstado" IsToggled="True" />
                                    </Grid>
                                </Border>

                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                    <Button x:Name="btnGuardarBiodigestor" Text="Guardar biodigestor" Clicked="btnGuardarBiodigestor_Clicked" />
                                    <Button Grid.Column="1" x:Name="btnActualizarBiodigestor" Text="Editar" Clicked="btnActualizarBiodigestor_Clicked" Style="{StaticResource BotonSecundario}" />
                                    <Button Grid.Row="1" Grid.ColumnSpan="2" x:Name="btnEliminarBiodigestor" Text="Eliminar" Clicked="btnEliminarBiodigestor_Clicked" Style="{StaticResource BotonSecundario}" TextColor="{StaticResource DangerRed}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="Biodigestores registrados" TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="18" />

                        <CollectionView x:Name="cvBiodigestores"
                                        SelectionMode="Single"
                                        SelectionChanged="cvBiodigestores_SelectionChanged">
                            <CollectionView.EmptyView>
                                <Label Text="No hay biodigestores disponibles en los datos del sistema." Style="{StaticResource EcoSubtitle}" HorizontalTextAlignment="Center" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource EcoCard}" Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding Id, StringFormat='Biodigestor #{0}'}"
                                                       TextColor="{StaticResource TextDark}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="16" />
                                                <Label Text="{Binding CapacidadMaxima, StringFormat='Capacidad máxima: {0} kg'}" Style="{StaticResource EcoSubtitle}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1" Style="{StaticResource StatusActivo}" VerticalOptions="Center">
                                                <Label Text="{Binding Estado, StringFormat='Activo: {0}'}" TextColor="{StaticResource DeepTeal}" FontSize="11" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
