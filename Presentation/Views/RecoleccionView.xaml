<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EcoHuellaApp.Presentation.ViewModels"
             xmlns:models="clr-namespace:EcoHuellaApp.Domain.Models.Recoleccion"
             x:Class="EcoHuellaApp.Presentation.Views.RecoleccionView"
             x:DataType="vm:RecoleccionViewModel"
             Title="RecoleccionView">
    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="10">

            <Label
                Text="Registro de Recolección"
                FontSize="24"
                HorizontalOptions="Center" />

            <DatePicker
                Date="{Binding Fecha}" />

            <Label
                Text="Casa" />
            <Picker
                Title="Seleccione una casa"
                ItemsSource="{Binding Casas}"
                ItemDisplayBinding="{Binding Direccion}"
                SelectedItem="{Binding CasaSeleccionada}" />

            <Label
                Text="Punto de Recolección" />
            <Picker
                Title="Seleccione un punto de recolección"
                ItemsSource="{Binding Puntos}"
                ItemDisplayBinding="{Binding Direccion}"
                SelectedItem="{Binding PuntoSeleccionado}" />

            <Button
                Text="Ver en mapa"
                Command="{Binding VerMapaCommand}" />

            <Label
                Text="Cantidad de cubetas/baldes" />
            <Entry
                Text="{Binding CantidadCubetas}"
                Placeholder="Cantidad de cubetas"
                Keyboard="Numeric" />

            <Label
                Text="Litros estimados" />
            <Entry
                Text="{Binding LitrosEstimados}"
                IsReadOnly="True"
                Keyboard="Numeric" />

            <Label
                Text="Masa estimada (kg)" />
            <Entry
                Text="{Binding MasaEstimada}"
                IsReadOnly="True"
                Keyboard="Numeric" />

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="10">

                <Button
                    Text="Guardar"
                    Command="{Binding GuardarCommand}" />

                <Button
                    Text="Actualizar"
                    Command="{Binding ActualizarCommand}" />

                <Button
                    Text="Eliminar"
                    Command="{Binding EliminarCommand}" />

            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               Margin="0,4,0,0"/>

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="#C0392B"
                   FontSize="13"/>

            <CollectionView
                ItemsSource="{Binding Recolecciones}"
                SelectedItem="{Binding RecoleccionSeleccionada}"
                SelectionMode="Single">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Recoleccion">
                        <Frame Margin="5">
                            <VerticalStackLayout>

                                <Label
                                    Text="{Binding Fecha, StringFormat='Fecha: {0:dd/MM/yyyy}'}"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Casa.Direccion, StringFormat='Casa: {0}'}" />

                                <Label
                                    Text="{Binding PuntoRecoleccion.Direccion, StringFormat='Punto: {0}'}" />

                                <Label
                                    Text="{Binding CantidadCubetas, StringFormat='Cubetas: {0}'}" />

                                <Label
                                    Text="{Binding LitrosEstimados, StringFormat='Litros: {0}'}" />

                                <Label
                                    Text="{Binding MasaEstimada, StringFormat='Masa: {0} kg'}" />

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
