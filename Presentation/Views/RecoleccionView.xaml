<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.RecoleccionView"
             Title="RecoleccionView">
    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="10">

            <Label
                Text="Registro de Recolección"
                FontSize="24"
                HorizontalOptions="Center" />

            <DatePicker
                x:Name="dpFecha" />

            <Label
                Text="Casa" />
            <Picker
                x:Name="pkCasa"
                Title="Seleccione una casa" />

            <Label
                Text="Punto de Recolección" />
            <Picker
                x:Name="pkPuntoRecoleccion"
                Title="Seleccione un punto de recolección" />

            <Button
                x:Name="btnVerMapa"
                Text="Ver en mapa"
                Clicked="btnVerMapa_Clicked" />

            <Label
                Text="Cantidad de cubetas/baldes" />
            <Entry
                x:Name="txtCantidadCubetas"
                Placeholder="Cantidad de cubetas"
                Keyboard="Numeric"
                TextChanged="txtCantidadCubetas_TextChanged" />

            <Label
                Text="Litros estimados" />
            <Entry
                x:Name="txtLitrosEstimados"
                IsReadOnly="True"
                Keyboard="Numeric" />

            <Label
                Text="Masa estimada (kg)" />
            <Entry
                x:Name="txtMasaEstimada"
                IsReadOnly="True"
                Keyboard="Numeric" />

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="10">

                <Button
                    x:Name="btnGuardar"
                    Text="Guardar"
                    Clicked="btnGuardar_Clicked" />

                <Button
                    x:Name="btnActualizar"
                    Text="Actualizar"
                    Clicked="btnActualizar_Clicked" />

                <Button
                    x:Name="btnEliminar"
                    Text="Eliminar"
                    Clicked="btnEliminar_Clicked" />

            </HorizontalStackLayout>

            <CollectionView
                x:Name="cvRecolecciones"
                SelectionMode="Single"
                SelectionChanged="cvRecolecciones_SelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="5">
                            <VerticalStackLayout>

                                <Label
                                    Text="{Binding Fecha, StringFormat='Fecha: {0:dd/MM/yyyy}'}"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Casa.Direccion, StringFormat='Casa: {0}'}" />

                                <Label
                                    Text="{Binding PuntoRecoleccion.Direccion, StringFormat='Punto: {0}'}" />

                                <Label
                                    Text="{Binding CantidadCubetas, StringFormat='Cubetas: {0}'}" />

                                <Label
                                    Text="{Binding LitrosEstimados, StringFormat='Litros: {0}'}" />

                                <Label
                                    Text="{Binding MasaEstimada, StringFormat='Masa: {0} kg'}" />

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
