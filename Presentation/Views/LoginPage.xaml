<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EcoHuellaApp.Presentation.ViewModels"
    x:DataType="vm:LoginViewModel"
    x:Class="EcoHuellaApp.Presentation.Views.LoginPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A2E}">

    <ScrollView>
        <VerticalStackLayout
            Padding="32,48,32,40"
            Spacing="0"
            VerticalOptions="Center">

            <!-- Encabezado -->
            <VerticalStackLayout Spacing="10" Margin="0,0,0,40" HorizontalOptions="Center">
                <Border
                    BackgroundColor="Black"
                    StrokeShape="RoundRectangle 24"
                    HeightRequest="88" WidthRequest="88"
                    HorizontalOptions="Center">
                    <Image Source="aldea_las_nubes.png"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Label Text="EcoHuella"
                       FontSize="30" FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}"/>
                <Label Text="Inicia sesión para continuar"
                       FontSize="14" HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
            </VerticalStackLayout>

            <!-- Correo -->
            <Label Text="Correo electrónico" FontSize="13" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                   Margin="0,0,0,6"/>
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#333}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#242424}"
                    Margin="0,0,0,20">
                <Entry Text="{Binding Email}"
                       Keyboard="Email" ReturnType="Next"
                       Placeholder="correo@ejemplo.com"
                       PlaceholderColor="{StaticResource Gray400}"
                       FontSize="15" Margin="14,10"/>
            </Border>

            <!-- Contraseña -->
            <Label Text="Contraseña" FontSize="13" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                   Margin="0,0,0,6"/>
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#333}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#242424}"
                    Margin="0,0,0,4">
                <Grid ColumnDefinitions="*,50">
                    <Entry Grid.Column="0"
                           Text="{Binding Password}"
                           IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InverseBool}}"
                           ReturnType="Done"
                           ReturnCommand="{Binding SignInCommand}"
                           Placeholder="Tu contraseña"
                           PlaceholderColor="{StaticResource Gray400}"
                           FontSize="15" Margin="14,10,0,10"/>
                    <Button Grid.Column="1"
                            Text="{Binding IsPasswordVisible,
                                   Converter={StaticResource BoolToStr},
                                   ConverterParameter='🙈|👁'}"
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            BackgroundColor="Transparent"
                            FontSize="18" Padding="0"
                            VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Recuperar contraseña -->
            <Button Text="¿Olvidaste tu contraseña?"
                    Command="{Binding ForgotPasswordCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    FontSize="13"
                    HorizontalOptions="End"
                    Padding="0,4,0,0"
                    IsEnabled="{Binding IsNotBusy}"/>

            <!-- Mensaje de error -->
            <Border IsVisible="{Binding HasError}"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="#FDEDEC"
                    Stroke="#E74C3C" StrokeThickness="1"
                    Padding="12,10" Margin="0,8,0,0">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="⚠️" FontSize="15" VerticalOptions="Center"/>
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#C0392B" FontSize="13"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap"
                           HorizontalOptions="FillAndExpand"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Mensaje de éxito (ej: correo de recuperación enviado) -->
            <Border IsVisible="{Binding HasSuccess}"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="#EAF7F0"
                    Stroke="#27AE60" StrokeThickness="1"
                    Padding="12,10" Margin="0,8,0,0">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="✅" FontSize="15" VerticalOptions="Center"/>
                    <Label Text="{Binding SuccessMessage}"
                           TextColor="#1E8449" FontSize="13"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap"
                           HorizontalOptions="FillAndExpand"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Botón Ingresar -->
            <Button Text="Ingresar"
                    Command="{Binding SignInCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold" FontSize="16"
                    HeightRequest="52" CornerRadius="14"
                    Margin="0,20,0,0"
                    IsEnabled="{Binding IsNotBusy}"/>

            <!-- Indicador de carga -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               Margin="0,14,0,0"/>

            <!-- Separador "o continúa con" -->
            <Grid ColumnDefinitions="*,Auto,*" Margin="0,24,0,0">
                <BoxView Grid.Column="0" HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark=#333}"
                         VerticalOptions="Center"/>
                <Label Grid.Column="1"
                       Text="  o continúa con  " FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                       VerticalOptions="Center"/>
                <BoxView Grid.Column="2" HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark=#333}"
                         VerticalOptions="Center"/>
            </Grid>

            <!-- Botón Google -->
            <Border StrokeShape="RoundRectangle 14"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#333}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#242424}"
                    Margin="0,16,0,0"
                    IsVisible="{OnPlatform Android=True, Default=True}">
                <Button Text="  Continuar con Google"
                        Command="{Binding SignInWithGoogleCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}"
                        FontAttributes="Bold" FontSize="15"
                        HeightRequest="52"
                        ImageSource="google_icon"
                        ContentLayout="Left,12"
                        IsEnabled="{Binding IsNotBusy}"/>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
