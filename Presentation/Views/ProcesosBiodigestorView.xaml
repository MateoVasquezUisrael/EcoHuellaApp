<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.ProcesosBiodigestorView"
             Title="Procesos del Biodigestor">
    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="10">

            <Label
                Text="Procesos del Biodigestor"
                FontSize="24"
                HorizontalOptions="Center" />

            <Label
                x:Name="lblInfoBiodigestor"
                FontSize="14"
                HorizontalOptions="Center" />

            <Button
                x:Name="btnIniciarProceso"
                Text="Iniciar Nuevo Proceso"
                Clicked="btnIniciarProceso_Clicked" />

            <Label
                Text="Procesos activos"
                FontAttributes="Bold"
                FontSize="18" />

            <CollectionView
                x:Name="cvProcesos"
                SelectionMode="Single"
                SelectionChanged="cvProcesos_SelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#242424}"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#333}"
                                Margin="5"
                                Padding="10">
                            <Grid ColumnDefinitions="*,Auto,Auto">

                                <VerticalStackLayout Grid.Column="0">

                                    <Label
                                        Text="{Binding Id, StringFormat='Proceso #{0}'}"
                                        FontAttributes="Bold" />

                                    <Label
                                        Text="{Binding FechaInicio, StringFormat='Inicio: {0:dd/MM/yyyy HH:mm}'}" />

                                    <Label
                                        Text="{Binding FechaEstimadaFinProceso, StringFormat='Fin estimado: {0:dd/MM/yyyy}'}" />

                                    <Label
                                        Text="Lleno"
                                        TextColor="Red"
                                        FontAttributes="Bold"
                                        IsVisible="{Binding EstadoLlenado}" />

                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="1"
                                    Text="Marcar lleno"
                                    CommandParameter="{Binding .}"
                                    Clicked="btnMarcarLleno_Clicked"
                                    Margin="5,0" />

                                <Button
                                    Grid.Column="2"
                                    Text="Finalizar"
                                    CommandParameter="{Binding .}"
                                    Clicked="btnFinalizarProceso_Clicked"
                                    Margin="5,0" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label
                x:Name="lblProcesoSeleccionado"
                Text="Ningún proceso seleccionado"
                FontAttributes="Bold"
                FontSize="16"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />

            <Label
                Text="Entradas del proceso seleccionado"
                FontAttributes="Bold"
                FontSize="18" />

            <DatePicker
                x:Name="dpFechaIngreso"
                Format="dd/MM/yyyy" />

            <Button
                x:Name="btnGuardarEntrada"
                Text="Guardar Entrada"
                Clicked="btnGuardarEntrada_Clicked" />

            <CollectionView
                x:Name="cvEntradas"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#242424}"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#333}"
                                Margin="5"
                                Padding="10">
                            <VerticalStackLayout>

                                <Label
                                    Text="{Binding FechaIngreso, StringFormat='Fecha: {0:dd/MM/yyyy}'}" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
