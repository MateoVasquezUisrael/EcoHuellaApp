<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.ProcesosBiodigestorView"
             Title="Procesos del Biodigestor">
    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="10">

            <Label
                Text="Procesos del Biodigestor"
                FontSize="24"
                HorizontalOptions="Center" />

            <Label
                x:Name="lblInfoBiodigestor"
                FontSize="14"
                HorizontalOptions="Center" />

            <Button
                x:Name="btnIniciarProceso"
                Text="Iniciar Nuevo Proceso"
                Clicked="btnIniciarProceso_Clicked" />

            <Label
                Text="Procesos activos"
                FontAttributes="Bold"
                FontSize="18" />

            <CollectionView
                x:Name="cvProcesos"
                SelectionMode="Single"
                SelectionChanged="cvProcesos_SelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="5">
                            <Grid ColumnDefinitions="*,Auto,Auto">

                                <VerticalStackLayout Grid.Column="0">

                                    <Label
                                        Text="{Binding Id, StringFormat='Proceso #{0}'}"
                                        FontAttributes="Bold" />

                                    <Label
                                        Text="{Binding FechaInicio, StringFormat='Inicio: {0:dd/MM/yyyy HH:mm}'}" />

                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="1"
                                    Text="Finalizar"
                                    CommandParameter="{Binding .}"
                                    Clicked="btnFinalizarProceso_Clicked"
                                    Margin="5,0" />

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label
                x:Name="lblProcesoSeleccionado"
                Text="Ningún proceso seleccionado"
                FontAttributes="Bold"
                FontSize="16"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />

            <Label
                Text="Entradas del proceso seleccionado"
                FontAttributes="Bold"
                FontSize="18" />

            <DatePicker
                x:Name="dpFechaIngreso"
                Format="dd/MM/yyyy" />

            <Button
                x:Name="btnGuardarEntrada"
                Text="Guardar Entrada"
                Clicked="btnGuardarEntrada_Clicked" />

            <CollectionView
                x:Name="cvEntradas"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="5">
                            <VerticalStackLayout>

                                <Label
                                    Text="{Binding FechaIngreso, StringFormat='Fecha: {0:dd/MM/yyyy}'}" />

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
