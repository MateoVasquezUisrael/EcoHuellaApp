<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.Front.vImpactoAmbiental"
             Title="Impacto Ambiental"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundSoft}">
    <Grid Padding="12" MaximumWidthRequest="430" HorizontalOptions="Center">
        <Image Source="eco_leaf.svg" WidthRequest="74" Opacity="0.14" Rotation="-26" HorizontalOptions="Start" VerticalOptions="Start" Margin="-20,-14,0,0" InputTransparent="True" />
        <Image Source="eco_leaf.svg" WidthRequest="92" Opacity="0.13" Rotation="30" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-28,-22" InputTransparent="True" />
        <Border Style="{StaticResource EcoCard}" MaximumWidthRequest="430" HorizontalOptions="Fill" VerticalOptions="Fill" Padding="0">
            <Grid RowDefinitions="116,*,64">
                <Border Style="{StaticResource EcoHeader}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="IMPACTO AMBIENTAL" TextColor="White" FontFamily="OpenSansSemibold" FontSize="20" />
                            <Label Text="Equivalencias y métricas clave" TextColor="#D9FFF1" FontSize="12" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="46" HeightRequest="46" BackgroundColor="#2237D6D6" Stroke="{StaticResource AccentTurquoise}" StrokeShape="RoundRectangle 23" VerticalOptions="Center">
                            <Label Text="&#x1F464;" TextColor="{StaticResource AccentTurquoise}" FontSize="23" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <ScrollView Grid.Row="1" Margin="0,-18,0,0">
                    <VerticalStackLayout Padding="18,0,18,20" Spacing="16">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                            <Border Style="{StaticResource EcoMetricCard}"><VerticalStackLayout><Label Text="CO₂ capturado" Style="{StaticResource EcoSubtitle}" HorizontalTextAlignment="Center" /><Label Text="1.2 ton" TextColor="{StaticResource PrimaryGreen}" FontFamily="OpenSansSemibold" FontSize="22" HorizontalTextAlignment="Center" /></VerticalStackLayout></Border>
                            <Border Grid.Column="1" Style="{StaticResource EcoMetricCard}"><VerticalStackLayout><Label Text="Metano evitado" Style="{StaticResource EcoSubtitle}" HorizontalTextAlignment="Center" /><Label Text="0.8 ton" TextColor="{StaticResource DeepTeal}" FontFamily="OpenSansSemibold" FontSize="22" HorizontalTextAlignment="Center" /></VerticalStackLayout></Border>
                            <Border Grid.Row="1" Style="{StaticResource EcoMetricCard}"><VerticalStackLayout><Label Text="Tierra regenerada" Style="{StaticResource EcoSubtitle}" HorizontalTextAlignment="Center" /><Label Text="500 m²" TextColor="{StaticResource PrimaryGreen}" FontFamily="OpenSansSemibold" FontSize="22" HorizontalTextAlignment="Center" /></VerticalStackLayout></Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource EcoMetricCard}"><VerticalStackLayout><Label Text="Biomasa procesada" Style="{StaticResource EcoSubtitle}" HorizontalTextAlignment="Center" /><Label Text="3.5 ton" TextColor="{StaticResource DeepTeal}" FontFamily="OpenSansSemibold" FontSize="22" HorizontalTextAlignment="Center" /></VerticalStackLayout></Border>
                        </Grid>

                        <Label Text="Equivalencias visuales" TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="20" />
                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="8">
                                <Border BackgroundColor="{StaticResource SoftGreen}" Stroke="{StaticResource BordeEco}" StrokeShape="RoundRectangle 24" WidthRequest="90" HeightRequest="82" HorizontalOptions="Center">
                                    <Label Text="🌿" FontSize="34" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <Label Text="120 árboles protegidos" TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="18" HorizontalTextAlignment="Center" />
                                <Label Text="Gracias a tu contribución." TextColor="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="8">
                                <Border BackgroundColor="{StaticResource SoftGreen}" Stroke="{StaticResource BordeEco}" StrokeShape="RoundRectangle 24" WidthRequest="90" HeightRequest="82" HorizontalOptions="Center">
                                    <Label Text="CO₂" TextColor="{StaticResource DeepTeal}" FontFamily="OpenSansSemibold" FontSize="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <Label Text="5000 km de emisiones evitadas" TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="18" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

                <Border Grid.Row="2" Style="{StaticResource EcoBottomNavigation}">
                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="24,*">
                        <Label Text="&#x267B;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="1" Text="&#x25F4;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="2" Text="&#x21BA;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="3" Text="&#x25A5;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Row="1" Text="Entregas" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="Dashboard" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="2" Text="Historial" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="3" Text="Procesos" Style="{StaticResource BottomNavText}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
