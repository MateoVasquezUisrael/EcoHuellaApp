<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.Front.vEditarPerfil"
             Title="Editar perfil"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundSoft}">
    <Grid Padding="12" MaximumWidthRequest="430" HorizontalOptions="Center">
        <Image Source="eco_leaf.svg" WidthRequest="76" Opacity="0.12" Rotation="-22" HorizontalOptions="Start" VerticalOptions="Start" Margin="-20,-12,0,0" InputTransparent="True" />
        <Border Style="{StaticResource EcoCard}" MaximumWidthRequest="430" HorizontalOptions="Fill" VerticalOptions="Fill" Padding="0">
            <Grid RowDefinitions="116,*">
                <Border Style="{StaticResource EcoHeader}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="EDITAR PERFIL" TextColor="White" FontFamily="OpenSansSemibold" FontSize="21" />
                            <Label Text="Datos disponibles de la cuenta" TextColor="#D9FFF1" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Iniciales}" TextColor="{StaticResource AccentTurquoise}" FontSize="24" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <ScrollView Grid.Row="1" Margin="0,-18,0,0">
                    <VerticalStackLayout Padding="18,0,18,20" Spacing="14">
                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="12" HorizontalOptions="Fill">
                                <Border Stroke="{StaticResource AccentTurquoise}" StrokeShape="RoundRectangle 48" WidthRequest="106" HeightRequest="106" HorizontalOptions="Center" BackgroundColor="#EAFBFB">
                                    <Label Text="{Binding Iniciales}" TextColor="{StaticResource AccentTurquoise}" FontSize="34" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <Button Text="Foto de perfil" Style="{StaticResource BotonSecundario}" IsEnabled="False" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="11">
                                <Label Text="Información del usuario" TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Label Text="Nombre completo" Style="{StaticResource EcoSubtitle}" />
                                <Border Style="{StaticResource CampoFormulario}"><Entry Text="{Binding Nombre}" Style="{StaticResource EntradaFormulario}" IsReadOnly="True" /></Border>
                                <Label Text="Correo electrónico" Style="{StaticResource EcoSubtitle}" />
                                <Border Style="{StaticResource CampoFormulario}"><Entry Text="{Binding Correo}" Keyboard="Email" Style="{StaticResource EntradaFormulario}" IsReadOnly="True" /></Border>
                                <Label Text="Rol" Style="{StaticResource EcoSubtitle}" />
                                <Border Style="{StaticResource CampoFormulario}"><Entry Text="{Binding Rol}" Style="{StaticResource EntradaFormulario}" IsReadOnly="True" /></Border>
                                <Label Text="Los campos aparecen en modo lectura porque la lógica de edición de perfil todavía no existe en los servicios actuales." Style="{StaticResource EcoSubtitle}" />
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Guardar cambios" IsEnabled="False" />
                            <Button Grid.Column="1" Text="Cancelar" Clicked="Cancelar_Clicked" Style="{StaticResource BotonSecundario}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
