<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.Front.vCambiarContrasena"
             Title="Cambiar contraseña"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundSoft}">
    <Grid Padding="12" MaximumWidthRequest="430" HorizontalOptions="Center">
        <Image Source="eco_leaf.svg" WidthRequest="76" Opacity="0.12" Rotation="28" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-22,-18" InputTransparent="True" />
        <Border Style="{StaticResource EcoCard}" MaximumWidthRequest="430" HorizontalOptions="Fill" VerticalOptions="Fill" Padding="0">
            <Grid RowDefinitions="116,*,64">
                <Border Style="{StaticResource EcoHeader}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="CAMBIAR CONTRASEÑA" TextColor="White" FontFamily="OpenSansSemibold" FontSize="20" />
                            <Label Text="Seguridad de la cuenta" TextColor="#D9FFF1" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="&#x2713;" TextColor="{StaticResource AccentTurquoise}" FontSize="30" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <ScrollView Grid.Row="1" Margin="0,-18,0,0">
                    <VerticalStackLayout Padding="18,0,18,20" Spacing="14">
                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Recomendación" TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Label Text="Usa una contraseña segura con letras, números y símbolos." TextColor="{StaticResource MutedText}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="11">
                                <Label Text="Nueva credencial" TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Label Text="Contraseña actual" Style="{StaticResource EcoSubtitle}" />
                                <Border Style="{StaticResource CampoFormulario}"><Entry IsPassword="True" Placeholder="Contraseña actual" Style="{StaticResource EntradaFormulario}" /></Border>
                                <Label Text="Nueva contraseña" Style="{StaticResource EcoSubtitle}" />
                                <Border Style="{StaticResource CampoFormulario}"><Entry IsPassword="True" Placeholder="Nueva contraseña" Style="{StaticResource EntradaFormulario}" /></Border>
                                <Label Text="Confirmar nueva contraseña" Style="{StaticResource EcoSubtitle}" />
                                <Border Style="{StaticResource CampoFormulario}"><Entry IsPassword="True" Placeholder="Confirmar nueva contraseña" Style="{StaticResource EntradaFormulario}" /></Border>
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Actualizar contraseña" FontSize="14" />
                            <Button Grid.Column="1" Text="Cancelar" Clicked="Cancelar_Clicked" Style="{StaticResource BotonSecundario}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>

                <Border Grid.Row="2" Style="{StaticResource EcoBottomNavigation}">
                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="24,*">
                        <Label Text="&#x267B;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="1" Text="&#x25F4;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="2" Text="&#x21BA;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="3" Text="&#x25A5;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Row="1" Text="Entregas" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="Dashboard" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="2" Text="Historial" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="3" Text="Procesos" Style="{StaticResource BottomNavText}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
