<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.Front.vAjustesPerfil"
             Title="Perfil"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundSoft}">
    <Grid Padding="12" MaximumWidthRequest="430" HorizontalOptions="Center">
        <Image Source="eco_leaf.svg" WidthRequest="72" Opacity="0.14" Rotation="-24" HorizontalOptions="Start" VerticalOptions="Start" Margin="-18,-10,0,0" InputTransparent="True" />
        <Image Source="eco_leaf.svg" WidthRequest="86" Opacity="0.13" Rotation="32" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-24,-18" InputTransparent="True" />
        <Border Style="{StaticResource EcoCard}" MaximumWidthRequest="430" HorizontalOptions="Fill" VerticalOptions="Fill" Padding="0">
            <Grid RowDefinitions="116,*,64">
                <Border Style="{StaticResource EcoHeader}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="PERFIL" TextColor="White" FontFamily="OpenSansSemibold" FontSize="22" />
                            <Label Text="Cuenta autenticada" TextColor="#D9FFF1" FontSize="12" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="46" HeightRequest="46" BackgroundColor="#2237D6D6" Stroke="{StaticResource AccentTurquoise}" StrokeShape="RoundRectangle 23" VerticalOptions="Center">
                            <Label Text="{Binding Iniciales}" TextColor="{StaticResource AccentTurquoise}" FontSize="17" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <ScrollView Grid.Row="1" Margin="0,-18,0,0">
                    <VerticalStackLayout Padding="18,0,18,20" Spacing="18">
                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="14" HorizontalOptions="Fill">
                                <Border Stroke="{StaticResource AccentTurquoise}" StrokeShape="RoundRectangle 48" WidthRequest="112" HeightRequest="112" HorizontalOptions="Center" BackgroundColor="#EAFBFB">
                                    <Label Text="{Binding Iniciales}" TextColor="{StaticResource AccentTurquoise}" FontSize="34" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding Nombre}" TextColor="{StaticResource TextDark}" FontFamily="OpenSansSemibold" FontSize="22" HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding Correo}" TextColor="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Información del usuario" TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout>
                                        <Label Text="Correo electrónico" Style="{StaticResource EcoSubtitle}" />
                                        <Label Text="{Binding Correo}" TextColor="{StaticResource TextDark}" FontFamily="OpenSansSemibold" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" Style="{StaticResource StatusActivo}" VerticalOptions="Center">
                                        <Label Text="{Binding Estado}" TextColor="{StaticResource DeepTeal}" FontSize="10" />
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Opciones de cuenta" TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Button Text="Cambiar contraseña" Clicked="CambiarContrasena_Clicked" Style="{StaticResource BotonSecundario}" />
                                <Button Text="Cerrar sesión" Clicked="CerrarSesion_Clicked" Style="{StaticResource BotonSecundario}" TextColor="{StaticResource DangerRed}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

                <Border Grid.Row="2" Style="{StaticResource EcoBottomNavigation}">
                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="24,*">
                        <Label Text="&#x21BA;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="1" Text="&#x267B;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="2" Text="&#x25F4;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="3" Text="&#x2699;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Row="1" Text="Historial" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="Entregas" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="2" Text="Dashboard" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="3" Text="Procesos" Style="{StaticResource BottomNavText}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
