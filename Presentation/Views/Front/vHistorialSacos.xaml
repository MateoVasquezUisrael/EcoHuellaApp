<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.Front.vHistorialSacos"
             Title="Historial de sacos"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundSoft}">
    <Grid Padding="12" MaximumWidthRequest="430" HorizontalOptions="Center">
        <Border Style="{StaticResource EcoCard}" MaximumWidthRequest="430" HorizontalOptions="Fill" VerticalOptions="Fill" Padding="0">
            <Grid RowDefinitions="116,*">
                <Border Style="{StaticResource EcoHeader}">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="HISTORIAL DE SACOS" TextColor="White" FontFamily="OpenSansSemibold" FontSize="21" />
                        <Label Text="{Binding Resumen}" TextColor="#D9FFF1" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
                <CollectionView Grid.Row="1" Margin="18,0,18,18" ItemsSource="{Binding Sacos}">
                    <CollectionView.EmptyView>
                        <Label Text="No hay sacos registrados." TextColor="{StaticResource MutedText}" HorizontalTextAlignment="Center" Margin="0,40" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource EcoCard}" Margin="0,8">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{Binding Id, StringFormat='Saco #{0}'}" TextColor="{StaticResource TextDark}" FontFamily="OpenSansSemibold" FontSize="17" />
                                    <Label Text="{Binding Fecha, StringFormat='Fecha: {0:dd/MM/yyyy}'}" TextColor="{StaticResource MutedText}" />
                                    <Label Text="{Binding EstadoTexto, StringFormat='Estado: {0}'}" TextColor="{StaticResource PrimaryGreen}" FontAttributes="Bold">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding EstadoTexto}" Value="Vendido">
                                                <Setter Property="TextColor" Value="{StaticResource DangerRed}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding Motivo, StringFormat='Motivo: {0}'}" TextColor="{StaticResource MutedText}" />
                                    <Label Text="{Binding ClienteVenta, StringFormat='Cliente: {0}'}" TextColor="{StaticResource MutedText}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
