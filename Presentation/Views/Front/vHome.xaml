<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.Front.vHome"
             Title="Dashboard"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundSoft}">
    <Grid Padding="12" MaximumWidthRequest="430" HorizontalOptions="Center">
        <Image Source="eco_leaf.svg" WidthRequest="78" Opacity="0.13" Rotation="-25" HorizontalOptions="Start" VerticalOptions="Start" Margin="-20,-10,0,0" InputTransparent="True" />
        <Image Source="eco_leaf.svg" WidthRequest="94" Opacity="0.12" Rotation="34" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-26,-18" InputTransparent="True" />

        <Border Style="{StaticResource EcoCard}" MaximumWidthRequest="430" HorizontalOptions="Fill" VerticalOptions="Fill" Padding="0">
            <Grid RowDefinitions="126,*,64">
                <Border Style="{StaticResource EcoHeader}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                            <Label Text="DASHBOARD" TextColor="White" FontFamily="OpenSansSemibold" FontSize="23" />
                            <Label Text="Análisis real de entregas y procesos" TextColor="#D9FFF1" FontSize="13" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="46" HeightRequest="46" BackgroundColor="#2237D6D6" Stroke="{StaticResource AccentTurquoise}" StrokeShape="RoundRectangle 23" VerticalOptions="Center">
                            <Label Text="&#x1F464;" TextColor="{StaticResource AccentTurquoise}" FontSize="23" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <ScrollView Grid.Row="1" Margin="0,-18,0,0">
                    <VerticalStackLayout Padding="18,0,18,20" Spacing="15">
                        <Border Style="{StaticResource EcoCard}" Padding="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Resumen ambiental" TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="18" />
                                    <Label Text="{Binding ResumenImpacto}" Style="{StaticResource EcoSubtitle}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Style="{StaticResource StatusActivo}" VerticalOptions="Center">
                                    <Label Text="REAL" TextColor="{StaticResource DeepTeal}" FontFamily="OpenSansSemibold" FontSize="10" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Filtros" TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <Border Style="{StaticResource CampoFormulario}">
                                        <DatePicker x:Name="dpDesde"
                                                    Format="dd/MM/yyyy"
                                                    DateSelected="FiltroFecha_DateSelected" />
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource CampoFormulario}">
                                        <DatePicker x:Name="dpHasta"
                                                    Format="dd/MM/yyyy"
                                                    DateSelected="FiltroFecha_DateSelected" />
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                            <Border Style="{StaticResource EcoMetricCard}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="KILOS" TextColor="{StaticResource MutedText}" FontSize="11" />
                                    <Label Text="{Binding TotalKilosTexto}" TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="23" />
                                    <Label Text="Procesados" Style="{StaticResource EcoSubtitle}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource EcoMetricCard}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="CO₂" TextColor="{StaticResource MutedText}" FontSize="11" />
                                    <Label Text="{Binding Co2EvitadoTexto}" TextColor="{StaticResource PrimaryGreen}" FontFamily="OpenSansSemibold" FontSize="23" />
                                    <Label Text="Evitado" Style="{StaticResource EcoSubtitle}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource EcoMetricCard}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="METANO" TextColor="{StaticResource MutedText}" FontSize="11" />
                                    <Label Text="{Binding MetanoEvitadoTexto}" TextColor="{StaticResource DeepTeal}" FontFamily="OpenSansSemibold" FontSize="23" />
                                    <Label Text="Evitado" Style="{StaticResource EcoSubtitle}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource EcoMetricCard}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="TIERRA" TextColor="{StaticResource MutedText}" FontSize="11" />
                                    <Label Text="{Binding TierraRegeneradaTexto}" TextColor="{StaticResource PrimaryGreen}" FontFamily="OpenSansSemibold" FontSize="23" />
                                    <Label Text="Regenerada" Style="{StaticResource EcoSubtitle}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource EcoMetricCard}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Eficiencia de procesos" TextColor="{StaticResource TextDark}" FontFamily="OpenSansSemibold" />
                                        <ProgressBar Progress="{Binding EficienciaProgreso}" ProgressColor="{StaticResource PrimaryGreen}" HeightRequest="8" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding EficienciaTexto}" TextColor="{StaticResource PrimaryGreen}" FontFamily="OpenSansSemibold" FontSize="24" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Evolución mensual" TextColor="{StaticResource TextDark}" FontFamily="OpenSansSemibold" />
                                    <Label Grid.Column="1" Text="kg/mes" TextColor="{StaticResource MutedText}" FontSize="11" />
                                </Grid>
                                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding EvolucionMensual}"
                                                       Spacing="9"
                                                       HeightRequest="150"
                                                       HorizontalOptions="Center">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout WidthRequest="45" Spacing="6" VerticalOptions="End">
                                                <Border BackgroundColor="{Binding Color}"
                                                        Stroke="Transparent"
                                                        StrokeShape="RoundRectangle 8"
                                                        HeightRequest="{Binding Altura}"
                                                        VerticalOptions="End" />
                                                <Label Text="{Binding Mes}" Style="{StaticResource EcoSubtitle}" HorizontalTextAlignment="Center" FontSize="11" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Reporte ambiental" TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Label Text="Resumen con métricas reales, evolución mensual y trazabilidad disponible." Style="{StaticResource EcoSubtitle}" />
                                <Button Text="Descargar reporte" HeightRequest="52" Clicked="DescargarReporte_Clicked" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

                <Border Grid.Row="2" Style="{StaticResource EcoBottomNavigation}">
                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="24,*">
                        <Label Text="&#x21BA;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="1" Text="&#x267B;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="2" Text="&#x25F4;" Style="{StaticResource BottomNavIconActive}" />
                        <Label Grid.Column="3" Text="&#x2699;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Row="1" Text="Historial" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="Entregas" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="2" Text="Dashboard" Style="{StaticResource BottomNavTextActive}" />
                        <Label Grid.Row="1" Grid.Column="3" Text="Procesos" Style="{StaticResource BottomNavText}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
