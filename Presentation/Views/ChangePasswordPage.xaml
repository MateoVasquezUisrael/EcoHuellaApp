<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EcoHuellaApp.Presentation.ViewModels"
    x:DataType="vm:ChangePasswordViewModel"
    x:Class="EcoHuellaApp.Presentation.Views.ChangePasswordPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A2E}">

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="0">

            <!-- Encabezado -->
            <VerticalStackLayout Spacing="8" Margin="0,48,0,40">
                <Label Text="🔒" FontSize="48" HorizontalOptions="Center"/>
                <Label Text="Establece tu contraseña"
                       FontSize="24" FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}"/>
                <Label Text="El administrador creó tu cuenta con una contraseña temporal. Crea una nueva contraseña para continuar."
                       FontSize="14" HorizontalTextAlignment="Center"
                       TextColor="{StaticResource Gray500}"
                       Margin="8,0"/>
            </VerticalStackLayout>

            <!-- Nueva contraseña -->
            <Label Text="Nueva contraseña" FontSize="13" FontAttributes="Bold"
                   TextColor="{StaticResource Gray600}" Margin="0,0,0,6"/>
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource Gray200}"
                    BackgroundColor="{StaticResource Gray100}"
                    Margin="0,0,0,8">
                <Entry Text="{Binding NewPassword}" IsPassword="True"
                       Placeholder="Mínimo 8 caracteres"
                       PlaceholderColor="{StaticResource Gray400}"
                       FontSize="15" Margin="14,10"/>
            </Border>

            <!-- Indicador de fortaleza -->
            <Grid ColumnDefinitions="*,Auto"
                  IsVisible="{Binding StrengthLabel, Converter={StaticResource StringNotEmpty}}"
                  Margin="0,0,0,20">
                <ProgressBar Grid.Column="0"
                             Progress="{Binding StrengthProgress}"
                             ProgressColor="{Binding StrengthColor}"
                             VerticalOptions="Center"/>
                <Label Grid.Column="1"
                       Text="{Binding StrengthLabel}"
                       FontSize="12"
                       TextColor="{Binding StrengthColor}"
                       Margin="8,0,0,0" VerticalOptions="Center"/>
            </Grid>

            <!-- Confirmar contraseña -->
            <Label Text="Confirmar contraseña" FontSize="13" FontAttributes="Bold"
                   TextColor="{StaticResource Gray600}" Margin="0,0,0,6"/>
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource Gray200}"
                    BackgroundColor="{StaticResource Gray100}"
                    Margin="0,0,0,8">
                <Entry Text="{Binding ConfirmPassword}" IsPassword="True"
                       Placeholder="Repite la nueva contraseña"
                       PlaceholderColor="{StaticResource Gray400}"
                       FontSize="15" Margin="14,10"/>
            </Border>

            <!-- Error -->
            <Border IsVisible="{Binding HasError}"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="#FDEDEC"
                    Stroke="#E74C3C" Padding="12,10" Margin="0,4,0,0">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="⚠️" FontSize="15" VerticalOptions="Center"/>
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#C0392B" FontSize="13"
                           VerticalOptions="Center" LineBreakMode="WordWrap"
                           HorizontalOptions="FillAndExpand"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Botón guardar -->
            <Button Text="Guardar y continuar"
                    Command="{Binding ChangePasswordCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold" FontSize="16"
                    HeightRequest="52" CornerRadius="14"
                    Margin="0,24,0,0"
                    IsEnabled="{Binding IsNotBusy}"/>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               Margin="0,14,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
