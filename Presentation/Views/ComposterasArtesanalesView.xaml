<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.ComposterasArtesanalesView"
             Title="Composteras artesanales"
             BackgroundColor="{StaticResource BackgroundSoft}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Border Style="{StaticResource EcoHeader}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Composteras artesanales"
                           Style="{StaticResource Headline}"
                           TextColor="White" />
                    <Label Text="Registra composteras y controla acciones de lixiviado o compost."
                           TextColor="#E8F5E9"
                           FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource EcoCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Nueva compostera"
                           Style="{StaticResource SubHeadline}" />
                    <Border Style="{StaticResource CampoFormulario}">
                        <Entry x:Name="txtPesoMaximo"
                               Placeholder="Peso máximo (kg)"
                               Keyboard="Numeric" />
                    </Border>
                    <VerticalStackLayout Spacing="10">
                        <Button x:Name="btnGuardarCompostera"
                                Text="Guardar compostera"
                                Clicked="btnGuardarCompostera_Clicked" />
                        <Button x:Name="btnHistorialAcciones"
                                Text="Historial de acciones"
                                Clicked="btnHistorialAcciones_Clicked"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource EcoCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Composteras registradas"
                           Style="{StaticResource SubHeadline}" />
                    <CollectionView x:Name="cvComposteras" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 16"
                                        BackgroundColor="White"
                                        Stroke="{StaticResource SoftGreen}"
                                        Margin="0,6"
                                        Padding="14">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                      <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding Id, StringFormat='Compostera #{0}'}"
                                               FontAttributes="Bold"
                                               FontSize="16" />
                                        <Label Text="{Binding PesoMaximo, StringFormat='Peso máximo: {0} kg'}"
                                               TextColor="{StaticResource MutedText}" />
                                        <Label Text="{Binding Estado, StringFormat='Activo: {0}'}"
                                               TextColor="{StaticResource DarkGreen}" />
                                      </VerticalStackLayout>
                                      <Button Grid.Column="1" Text="Acciones" CommandParameter="{Binding .}"
                                              Clicked="btnAccionesCompostera_Clicked" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
