<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.SacosCompostView"
             Title="Sacos de compost"
             BackgroundColor="{StaticResource BackgroundSoft}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Border Style="{StaticResource EcoHeader}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Sacos de compost"
                           Style="{StaticResource Headline}"
                           TextColor="White" />
                    <Label Text="Registra sacos disponibles y controla su venta o consumo."
                           TextColor="#E8F5E9"
                           FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource EcoCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Nuevo saco"
                           Style="{StaticResource SubHeadline}" />
                    <Border Style="{StaticResource CampoFormulario}">
                        <DatePicker x:Name="dpFechaRegistro"
                                    Format="dd/MM/yyyy" />
                    </Border>
                    <VerticalStackLayout Spacing="10">
                        <Button x:Name="btnGuardarSaco"
                                Text="Guardar saco"
                                Clicked="btnGuardarSaco_Clicked" />
                        <Button x:Name="btnHistorialSacos"
                                Text="Historial de sacos usados"
                                Clicked="btnHistorialSacos_Clicked"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource EcoCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Sacos disponibles"
                           Style="{StaticResource SubHeadline}" />
                    <CollectionView x:Name="cvSacosDisponibles" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 16"
                                        BackgroundColor="White"
                                        Stroke="{StaticResource LightGreen}"
                                        Margin="0,6"
                                        Padding="14">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                      <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding Id, StringFormat='Saco #{0}'}"
                                               FontAttributes="Bold"
                                               FontSize="16" />
                                        <Label Text="{Binding Fecha, StringFormat='Registrado: {0:dd/MM/yyyy}'}"
                                               TextColor="{StaticResource MutedText}" />
                                        <Label Text="Disponible"
                                               TextColor="{StaticResource DarkGreen}"
                                               FontAttributes="Bold" />
                                      </VerticalStackLayout>
                                      <Button Grid.Column="1" Text="Acciones" CommandParameter="{Binding .}"
                                              Clicked="btnAccionesSaco_Clicked" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
