<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EcoHuellaApp.Presentation.ViewModels"
             xmlns:models="clr-namespace:EcoHuellaApp.Domain.Models.Ventas"
             x:Class="EcoHuellaApp.Presentation.Views.SacosCompostView"
             x:DataType="vm:SacosCompostViewModel"
             Title="Sacos de Compost">
    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="10">

            <Label
                Text="Gestión de Sacos de Compost"
                FontSize="24"
                HorizontalOptions="Center" />

            <!-- Formulario nuevo saco -->
            <Label
                Text="Nuevo Saco"
                FontAttributes="Bold"
                FontSize="18" />

            <DatePicker
                Date="{Binding FechaRegistro}"
                Format="dd/MM/yyyy" />

            <Button
                Text="Guardar Saco"
                Command="{Binding GuardarSacoCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               Margin="0,4,0,0"/>

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="#C0392B"
                   FontSize="13"/>

            <!-- Lista de sacos disponibles -->
            <Label
                Text="Sacos disponibles"
                FontAttributes="Bold"
                FontSize="18" />

            <CollectionView
                ItemsSource="{Binding SacosDisponibles}"
                SelectedItem="{Binding SacoSeleccionado}"
                SelectionMode="Single">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SacosCompost">
                        <Border StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#242424}"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#333}"
                                Margin="5"
                                Padding="10">
                            <VerticalStackLayout>

                                <Label
                                    Text="{Binding Id, StringFormat='Saco #{0}'}"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Fecha, StringFormat='Registrado: {0:dd/MM/yyyy}'}" />

                                <Label
                                    Text="Disponible"
                                    TextColor="Green" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- Formulario uso/venta -->
            <Label
                Text="Usar / vender saco"
                FontAttributes="Bold"
                FontSize="18"
                IsVisible="{Binding IsFormularioUsoVisible}" />

            <Picker
                Title="Motivo"
                SelectedItem="{Binding MotivoSeleccionado}"
                IsVisible="{Binding IsFormularioUsoVisible}">
                <Picker.Items>
                    <x:String>Venta</x:String>
                    <x:String>Consumo</x:String>
                </Picker.Items>
            </Picker>

            <Entry
                Text="{Binding ClienteVenta}"
                Placeholder="Cliente (solo para venta)"
                IsVisible="{Binding IsClienteVisible}" />

            <Button
                Text="Confirmar uso / venta"
                Command="{Binding ConfirmarUsoCommand}"
                IsVisible="{Binding IsFormularioUsoVisible}" />

            <!-- Lista de sacos usados/vendidos -->
            <Label
                Text="Sacos usados o vendidos"
                FontAttributes="Bold"
                FontSize="18" />

            <CollectionView
                ItemsSource="{Binding SacosUsados}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SacosCompost">
                        <Border StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#242424}"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark=#333}"
                                Margin="5"
                                Padding="10">
                            <VerticalStackLayout>

                                <Label
                                    Text="{Binding Id, StringFormat='Saco #{0}'}"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Fecha, StringFormat='Registrado: {0:dd/MM/yyyy}'}" />

                                <Label
                                    Text="{Binding Motivo, StringFormat='Motivo: {0}'}" />

                                    <Label
                                    Text="{Binding ClienteVenta, StringFormat='Cliente: {0}'}"
                                    IsVisible="{Binding ClienteVenta, Converter={StaticResource StringNotEmpty}}" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
