<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.Front.vHistorialEntregas"
             Title="Historial"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundSoft}">
    <Grid Padding="12" MaximumWidthRequest="430" HorizontalOptions="Center">
        <Image Source="eco_leaf.svg" WidthRequest="78" Opacity="0.12" Rotation="-24" HorizontalOptions="Start" VerticalOptions="Start" Margin="-22,-12,0,0" InputTransparent="True" />
        <Border Style="{StaticResource EcoCard}" MaximumWidthRequest="430" HorizontalOptions="Fill" VerticalOptions="Fill" Padding="0">
            <Grid RowDefinitions="116,*,64">
                <Border Style="{StaticResource EcoHeader}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="HISTORIAL" TextColor="White" FontFamily="OpenSansSemibold" FontSize="21" />
                            <Label Text="Trazabilidad de entregas orgánicas" TextColor="#D9FFF1" FontSize="12" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="46" HeightRequest="46" BackgroundColor="#2237D6D6" Stroke="{StaticResource AccentTurquoise}" StrokeShape="RoundRectangle 23" VerticalOptions="Center">
                            <Label Text="&#x1F464;" TextColor="{StaticResource AccentTurquoise}" FontSize="23" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <ScrollView Grid.Row="1" Margin="0,-18,0,0">
                    <VerticalStackLayout Padding="18,0,18,20" Spacing="14">
                        <Border Style="{StaticResource EcoCard}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="Entregas registradas" Style="{StaticResource EcoTitle}" FontSize="23" />
                                    <Label Text="Consulta registros reales guardados en la aplicación." Style="{StaticResource EcoSubtitle}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Style="{StaticResource StatusActivo}" VerticalOptions="Center">
                                    <Label Text="{Binding TotalRegistrosTexto}" TextColor="{StaticResource DeepTeal}" FontSize="11" />
                                </Border>
                            </Grid>
                        </Border>

                        <CollectionView ItemsSource="{Binding Recolecciones}" SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Border Style="{StaticResource EcoCard}" Margin="0,8">
                                    <Label Text="No hay entregas registradas todavía." TextColor="{StaticResource MutedText}" HorizontalTextAlignment="Center" />
                                </Border>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource EcoCard}" Margin="0,8">
                                        <VerticalStackLayout Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding Id, StringFormat='Entrega #{0}'}" TextColor="{StaticResource TextDark}" FontFamily="OpenSansSemibold" FontSize="17" />
                                                <Border Grid.Column="1" Style="{StaticResource StatusActivo}">
                                                    <Label Text="Activa" TextColor="{StaticResource DeepTeal}" FontSize="10" />
                                                </Border>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*">
                                                <VerticalStackLayout>
                                                    <Label Text="Fecha" Style="{StaticResource EcoSubtitle}" />
                                                    <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" TextColor="{StaticResource TextDark}" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="1">
                                                    <Label Text="Kilos" Style="{StaticResource EcoSubtitle}" />
                                                    <Label Text="{Binding MasaEstimada, StringFormat='{0:N1} kg'}" TextColor="{StaticResource PrimaryGreen}" FontFamily="OpenSansSemibold" />
                                                </VerticalStackLayout>
                                            </Grid>
                                            <Label Text="{Binding CantidadCubetas, StringFormat='Cubetas: {0}'}" TextColor="{StaticResource TextDark}" />
                                            <Label Text="{Binding LitrosEstimados, StringFormat='Litros estimados: {0:N1} L'}" TextColor="{StaticResource MutedText}" />
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                                <Button Text="Ver" Clicked="Detalle_Clicked" Style="{StaticResource BotonSecundario}" FontSize="11" Padding="8" />
                                                <Button Grid.Column="1" Text="Editar" Clicked="Editar_Clicked" Style="{StaticResource BotonSecundario}" FontSize="11" Padding="8" />
                                                <Button Grid.Column="2" Text="Eliminar" Clicked="Eliminar_Clicked" Style="{StaticResource BotonSecundario}" TextColor="{StaticResource DangerRed}" FontSize="11" Padding="8" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </ScrollView>

                <Border Grid.Row="2" Style="{StaticResource EcoBottomNavigation}">
                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="24,*">
                        <Label Text="&#x21BA;" Style="{StaticResource BottomNavIconActive}" />
                        <Label Grid.Column="1" Text="&#x267B;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="2" Text="&#x25F4;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="3" Text="&#x2699;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Row="1" Text="Historial" Style="{StaticResource BottomNavTextActive}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="Entregas" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="2" Text="Dashboard" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="3" Text="Procesos" Style="{StaticResource BottomNavText}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
