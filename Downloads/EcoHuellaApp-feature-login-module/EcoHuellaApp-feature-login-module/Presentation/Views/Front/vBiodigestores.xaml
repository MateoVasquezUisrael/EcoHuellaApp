<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.Front.vBiodigestores"
             Title="Biodigestores"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundSoft}">
    <Grid Padding="12" MaximumWidthRequest="430" HorizontalOptions="Center">
        <Image Source="eco_leaf.svg" WidthRequest="82" Opacity="0.12" Rotation="32" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-24,-18" InputTransparent="True" />
        <Border Style="{StaticResource EcoCard}" MaximumWidthRequest="430" HorizontalOptions="Fill" VerticalOptions="Fill" Padding="0">
            <Grid RowDefinitions="116,*,64">
                <Border Style="{StaticResource EcoHeader}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="BIODIGESTORES" TextColor="White" FontFamily="OpenSansSemibold" FontSize="21" />
                            <Label Text="Monitoreo operativo y producción" TextColor="#D9FFF1" FontSize="12" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="46" HeightRequest="46" BackgroundColor="#2237D6D6" Stroke="{StaticResource AccentTurquoise}" StrokeShape="RoundRectangle 23" VerticalOptions="Center">
                            <Label Text="&#x1F464;" TextColor="{StaticResource AccentTurquoise}" FontSize="23" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <ScrollView Grid.Row="1" Margin="0,-18,0,0">
                    <VerticalStackLayout Padding="18,0,18,20" Spacing="14">
                        <Border Style="{StaticResource EcoCard}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout>
                                    <Label Text="Estado general" Style="{StaticResource EcoSubtitle}" />
                                    <Label Text="Sistema estable" TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="21" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Style="{StaticResource StatusActivo}" VerticalOptions="Center"><Label Text="ACTIVO" TextColor="{StaticResource DeepTeal}" FontFamily="OpenSansSemibold" FontSize="11" /></Border>
                            </Grid>
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Text="Gestionar" Clicked="GestionarBiodigestores_Clicked" HeightRequest="48" />
                            <Button Grid.Column="1" Text="Procesos" Clicked="Procesos_Clicked" Style="{StaticResource BotonSecundario}" HeightRequest="48" />
                        </Grid>
                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto"><Label Text="Biodigestor 1" TextColor="{StaticResource TextDark}" FontFamily="OpenSansSemibold" FontSize="17" /><Border Grid.Column="1" Style="{StaticResource StatusActivo}"><Label Text="Activo" TextColor="{StaticResource DeepTeal}" FontSize="11" /></Border></Grid>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10"><Label Text="Biogás generado&#10;150 m³" TextColor="{StaticResource TextDark}" /><Label Grid.Column="1" Text="Fertilizante&#10;200 kg" TextColor="{StaticResource TextDark}" /><Label Grid.Row="1" Text="Biomasa&#10;500 kg" TextColor="{StaticResource TextDark}" /><Label Grid.Row="1" Grid.Column="1" Text="Capacidad&#10;75%" TextColor="{StaticResource PrimaryGreen}" FontAttributes="Bold" /></Grid>
                                <ProgressBar Progress="0.75" ProgressColor="{StaticResource PrimaryGreen}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto"><Label Text="Biodigestor 2" TextColor="{StaticResource TextDark}" FontFamily="OpenSansSemibold" FontSize="17" /><Border Grid.Column="1" Style="{StaticResource StatusAdvertencia}"><Label Text="Mantenimiento" TextColor="{StaticResource WarningOrange}" FontSize="11" /></Border></Grid>
                                <Grid ColumnDefinitions="*,*"><Label Text="Biogás generado&#10;80 m³" TextColor="{StaticResource TextDark}" /><Label Grid.Column="1" Text="Capacidad&#10;60%" TextColor="{StaticResource WarningOrange}" FontAttributes="Bold" /></Grid>
                                <ProgressBar Progress="0.60" ProgressColor="{StaticResource WarningOrange}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource StatusAdvertencia}" Padding="14"><Label Text="Mantenimiento preventivo recomendado en Biodigestor 2" TextColor="{StaticResource WarningOrange}" /></Border>
                    </VerticalStackLayout>
                </ScrollView>

                <Border Grid.Row="2" Style="{StaticResource EcoBottomNavigation}">
                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="24,*">
                        <Label Text="&#x267B;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="1" Text="&#x25F4;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="2" Text="&#x21BA;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="3" Text="&#x25A5;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Row="1" Text="Entregas" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="Dashboard" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="2" Text="Historial" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="3" Text="Procesos" Style="{StaticResource BottomNavText}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
