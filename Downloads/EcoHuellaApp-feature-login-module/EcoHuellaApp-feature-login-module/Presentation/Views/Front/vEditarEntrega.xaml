<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.Front.vEditarEntrega"
             Title="Editar entrega"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundSoft}">
    <Grid Padding="12" MaximumWidthRequest="430" HorizontalOptions="Center">
        <Image Source="eco_leaf.svg" WidthRequest="74" Opacity="0.12" Rotation="-25" HorizontalOptions="Start" VerticalOptions="Start" Margin="-20,-10,0,0" InputTransparent="True" />
        <Border Style="{StaticResource EcoCard}" MaximumWidthRequest="430" HorizontalOptions="Fill" VerticalOptions="Fill" Padding="0">
            <Grid RowDefinitions="116,*,64">
                <Border Style="{StaticResource EcoHeader}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="EDITAR ENTREGA" TextColor="White" FontFamily="OpenSansSemibold" FontSize="21" />
                            <Label Text="Actualiza los datos del registro" TextColor="#D9FFF1" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="&#x2713;" TextColor="{StaticResource AccentTurquoise}" FontSize="30" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <ScrollView Grid.Row="1" Margin="0,-18,0,0">
                    <VerticalStackLayout Padding="18,0,18,20" Spacing="14">
                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="11">
                                <Label Text="Datos precargados" TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Label Text="Kilos de residuo fresco" Style="{StaticResource EcoSubtitle}" />
                                <Border Style="{StaticResource CampoFormulario}"><Entry Text="15.5" Keyboard="Numeric" Style="{StaticResource EntradaFormulario}" /></Border>
                                <Label Text="Tipo de residuo" Style="{StaticResource EcoSubtitle}" />
                                <Border Style="{StaticResource CampoFormulario}">
                                    <Picker Title="Orgánico" TextColor="{StaticResource TextDark}" TitleColor="{StaticResource MutedText}" BackgroundColor="Transparent">
                                        <Picker.Items><x:String>Orgánico</x:String><x:String>Vegetal</x:String><x:String>Compostable</x:String></Picker.Items>
                                    </Picker>
                                </Border>
                                <Label Text="Fecha" Style="{StaticResource EcoSubtitle}" />
                                <Border Style="{StaticResource CampoFormulario}"><DatePicker Format="dd/MM/yyyy" TextColor="{StaticResource TextDark}" BackgroundColor="Transparent" /></Border>
                                <Label Text="Responsable" Style="{StaticResource EcoSubtitle}" />
                                <Border Style="{StaticResource CampoFormulario}"><Entry Text="{Binding NombreResponsable}" Style="{StaticResource EntradaFormulario}" IsReadOnly="True" /></Border>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="11">
                                <Label Text="Ubicación y observaciones" TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Border Style="{StaticResource CampoFormulario}"><Entry Text="Sector A" Style="{StaticResource EntradaFormulario}" /></Border>
                                <Border BackgroundColor="{StaticResource CardWhite}" Stroke="{StaticResource BordeCampoFormulario}" StrokeShape="RoundRectangle 18" Padding="12" HeightRequest="92">
                                    <Editor Text="Residuos de cocina y jardín." TextColor="{StaticResource TextDark}" BackgroundColor="Transparent" AutoSize="TextChanges" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource EcoCard}">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Evidencia fotográfica" TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button Text="Tomar foto" Style="{StaticResource BotonSecundario}" FontSize="13" IsEnabled="False" />
                                    <Button Grid.Column="1" Text="Seleccionar de galería" Style="{StaticResource BotonSecundario}" FontSize="12" IsEnabled="False" />
                                </Grid>
                                <Border BackgroundColor="{StaticResource BackgroundSoft}" Stroke="{StaticResource BordeEco}" StrokeShape="RoundRectangle 18" Padding="14" HeightRequest="82">
                                    <Label Text="No hay imágenes cargadas" TextColor="{StaticResource MutedText}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Actualizar registro" />
                            <Button Grid.Column="1" Text="Cancelar" Clicked="Cancelar_Clicked" Style="{StaticResource BotonSecundario}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>

                <Border Grid.Row="2" Style="{StaticResource EcoBottomNavigation}">
                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="24,*">
                        <Label Text="&#x267B;" Style="{StaticResource BottomNavIconActive}" />
                        <Label Grid.Column="1" Text="&#x25F4;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="2" Text="&#x21BA;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Column="3" Text="&#x25A5;" Style="{StaticResource BottomNavIcon}" />
                        <Label Grid.Row="1" Text="Entregas" Style="{StaticResource BottomNavTextActive}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="Dashboard" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="2" Text="Historial" Style="{StaticResource BottomNavText}" />
                        <Label Grid.Row="1" Grid.Column="3" Text="Procesos" Style="{StaticResource BottomNavText}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
