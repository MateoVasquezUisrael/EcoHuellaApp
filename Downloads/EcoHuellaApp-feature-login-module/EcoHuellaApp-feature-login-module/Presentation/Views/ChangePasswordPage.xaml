<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EcoHuellaApp.Presentation.ViewModels"
             x:DataType="vm:ChangePasswordViewModel"
             x:Class="EcoHuellaApp.Presentation.Views.ChangePasswordPage"
             Shell.NavBarIsVisible="False" SafeAreaEdges="All"
             BackgroundColor="{StaticResource BackgroundSoft}">
    <ScrollView HorizontalScrollBarVisibility="Never">
        <Grid Padding="20,28,20,32">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#EDF8F2" Offset="0" />
                    <GradientStop Color="#FAFCFB" Offset="0.55" />
                    <GradientStop Color="#E8F7F5" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <VerticalStackLayout Spacing="20" MaximumWidthRequest="390"
                                 HorizontalOptions="Center" VerticalOptions="Center">
                <Border Background="{StaticResource HeaderGradientBrush}" Stroke="Transparent"
                        StrokeShape="RoundRectangle 32" Padding="24,26">
                    <VerticalStackLayout Spacing="10">
                        <Border WidthRequest="66" HeightRequest="66" BackgroundColor="#2237D6D6"
                                Stroke="{StaticResource AccentTurquoise}" StrokeShape="RoundRectangle 22"
                                HorizontalOptions="Center">
                            <Label Text="&#x1F512;" FontSize="29" HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                        <Label Text="SEGURIDAD DE LA CUENTA" TextColor="{StaticResource AccentTurquoise}"
                               FontFamily="OpenSansSemibold" FontSize="10" CharacterSpacing="1.4"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Crea una contraseña nueva" TextColor="White"
                               FontFamily="OpenSansSemibold" FontSize="27"
                               HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                        <Label Text="La contraseña temporal dejará de funcionar cuando guardes el cambio."
                               TextColor="#D9FFF1" FontSize="13" HorizontalTextAlignment="Center"
                               LineHeight="1.2" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource EcoCard}" Padding="24">
                    <VerticalStackLayout Spacing="13">
                        <Label Text="Actualizar contraseña" TextColor="{StaticResource DarkGreen}"
                               FontFamily="OpenSansSemibold" FontSize="22" />
                        <Label Text="Usa al menos 8 caracteres. Para mayor seguridad combina letras, números y símbolos."
                               Style="{StaticResource EcoSubtitle}" FontSize="12" />

                        <Label Text="Nueva contraseña" TextColor="{StaticResource TextDark}"
                               FontFamily="OpenSansSemibold" Margin="0,5,0,0" />
                        <Border Style="{StaticResource CampoFormulario}">
                            <Entry Text="{Binding NewPassword}" IsPassword="True"
                                   Placeholder="Mínimo 8 caracteres" ReturnType="Next"
                                   Style="{StaticResource EntradaFormulario}" />
                        </Border>

                        <Grid ColumnDefinitions="*,Auto"
                              IsVisible="{Binding StrengthLabel, Converter={StaticResource StringNotEmpty}}"
                              ColumnSpacing="10">
                            <ProgressBar Progress="{Binding StrengthProgress}"
                                         ProgressColor="{Binding StrengthColor}"
                                         HeightRequest="7" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding StrengthLabel}"
                                   TextColor="{Binding StrengthColor}"
                                   FontFamily="OpenSansSemibold" FontSize="11" />
                        </Grid>

                        <Label Text="Confirmar contraseña" TextColor="{StaticResource TextDark}"
                               FontFamily="OpenSansSemibold" Margin="0,4,0,0" />
                        <Border Style="{StaticResource CampoFormulario}">
                            <Entry Text="{Binding ConfirmPassword}" IsPassword="True"
                                   Placeholder="Repite la nueva contraseña" ReturnType="Done"
                                   ReturnCommand="{Binding ChangePasswordCommand}"
                                   Style="{StaticResource EntradaFormulario}" />
                        </Border>

                        <Border IsVisible="{Binding HasError}"
                                BackgroundColor="{StaticResource DangerSurface}" Stroke="#FAC0C3"
                                StrokeShape="RoundRectangle 14" Padding="12,10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="&#x26A0;" FontSize="15" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding ErrorMessage}" TextColor="#C0392B"
                                       FontSize="12" LineBreakMode="WordWrap" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Button Text="Guardar contraseña" Command="{Binding ChangePasswordCommand}"
                                HeightRequest="52" Margin="0,7,0,0" IsEnabled="{Binding IsNotBusy}" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource PrimaryGreen}" HorizontalOptions="Center" />
                        <Label Text="Al guardar volverás automáticamente al sistema."
                               TextColor="{StaticResource MutedText}" FontSize="11"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
