<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.ComposterasArtesanalesView"
             Title="Composteras artesanales"
             BackgroundColor="{StaticResource BackgroundSoft}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Border Style="{StaticResource EcoHeader}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Composteras artesanales"
                           Style="{StaticResource Headline}"
                           TextColor="White" />
                    <Label Text="Registra composteras y controla acciones de lixiviado o compost."
                           TextColor="#E8F5E9"
                           FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource EcoCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Nueva compostera"
                           Style="{StaticResource SubHeadline}" />
                    <Border Style="{StaticResource CampoFormulario}">
                        <Entry x:Name="txtPesoMaximo"
                               Placeholder="Peso máximo (kg)"
                               Keyboard="Numeric" />
                    </Border>
                    <Button x:Name="btnGuardarCompostera"
                            Text="Guardar compostera"
                            Clicked="btnGuardarCompostera_Clicked" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource EcoCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Composteras registradas"
                           Style="{StaticResource SubHeadline}" />
                    <CollectionView x:Name="cvComposteras"
                                    SelectionMode="Single"
                                    SelectionChanged="cvComposteras_SelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 16"
                                        BackgroundColor="White"
                                        Stroke="{StaticResource LightGreen}"
                                        Margin="0,6"
                                        Padding="14">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding Id, StringFormat='Compostera #{0}'}"
                                               FontAttributes="Bold"
                                               FontSize="16" />
                                        <Label Text="{Binding PesoMaximo, StringFormat='Peso máximo: {0} kg'}"
                                               TextColor="{StaticResource MutedText}" />
                                        <Label Text="{Binding Estado, StringFormat='Activo: {0}'}"
                                               TextColor="{StaticResource DarkGreen}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource EcoCard}">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="lblAccionTitulo"
                           Text="Acciones de la compostera"
                           Style="{StaticResource SubHeadline}"
                           IsVisible="False" />

                    <Border Style="{StaticResource CampoFormulario}" IsVisible="{Binding Source={x:Reference pickerTipoAccion}, Path=IsVisible}">
                        <Picker x:Name="pickerTipoAccion"
                                Title="Tipo de acción"
                                IsVisible="False">
                            <Picker.Items>
                                <x:String>Insertar</x:String>
                                <x:String>Extraer</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>

                    <Border Style="{StaticResource CampoFormulario}" IsVisible="{Binding Source={x:Reference dpFechaAccion}, Path=IsVisible}">
                        <DatePicker x:Name="dpFechaAccion"
                                    Format="dd/MM/yyyy"
                                    IsVisible="False" />
                    </Border>

                    <Border Style="{StaticResource CampoFormulario}" IsVisible="{Binding Source={x:Reference pickerTipoElemento}, Path=IsVisible}">
                        <Picker x:Name="pickerTipoElemento"
                                Title="Tipo de elemento"
                                IsVisible="False">
                            <Picker.Items>
                                <x:String>Lixiviado</x:String>
                                <x:String>Compost</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>

                    <Button x:Name="btnGuardarAccion"
                            Text="Guardar acción"
                            Clicked="btnGuardarAccion_Clicked"
                            IsVisible="False" />

                    <CollectionView x:Name="cvAcciones"
                                    SelectionMode="None"
                                    IsVisible="False">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 16"
                                        BackgroundColor="White"
                                        Stroke="{StaticResource Gray200}"
                                        Margin="0,6"
                                        Padding="14">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding TipoAccion, StringFormat='Acción: {0}'}"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding TipoElemento, StringFormat='Elemento: {0}'}"
                                               TextColor="{StaticResource MutedText}" />
                                        <Label Text="{Binding FechaAccion, StringFormat='Fecha: {0:dd/MM/yyyy}'}"
                                               TextColor="{StaticResource MutedText}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
