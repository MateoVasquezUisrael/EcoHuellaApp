<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoHuellaApp.Presentation.Views.GuestDemoPage"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="All"
             BackgroundColor="{StaticResource BackgroundSoft}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Background="{StaticResource HeaderGradientBrush}"
                Stroke="Transparent" StrokeShape="RoundRectangle 0,0,30,30"
                Padding="22,18">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="3">
                    <Label Text="MODO DEMOSTRACIÓN" TextColor="{StaticResource AccentTurquoise}"
                           FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.4" />
                    <Label Text="Conoce EcoHuella" TextColor="White"
                           FontFamily="OpenSansSemibold" FontSize="25" />
                    <Label Text="Vista de ejemplo • Sin acceso a datos reales"
                           TextColor="#D9FFF1" FontSize="12" />
                </VerticalStackLayout>
                <Border Grid.Column="1" WidthRequest="48" HeightRequest="48"
                        BackgroundColor="#2237D6D6" Stroke="{StaticResource AccentTurquoise}"
                        StrokeShape="RoundRectangle 24" VerticalOptions="Center">
                    <Label Text="&#x1F441;" FontSize="22" HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" HorizontalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="18,20" Spacing="14" MaximumWidthRequest="430"
                                 HorizontalOptions="Center">
                <Border BackgroundColor="{StaticResource WarningSurface}"
                        Stroke="#F4D58D" StrokeShape="RoundRectangle 18" Padding="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="&#x24D8;" TextColor="{StaticResource WarningOrange}" FontSize="21" />
                        <Label Grid.Column="1"
                               Text="Esta información es ilustrativa. En modo invitado no puedes crear, editar, eliminar ni descargar reportes."
                               TextColor="{StaticResource TextDark}" FontSize="12" LineHeight="1.25" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Style="{StaticResource EcoMetricCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="RESIDUOS" TextColor="{StaticResource MutedText}" FontSize="10" />
                            <Label Text="248 kg" TextColor="{StaticResource DarkGreen}"
                                   FontFamily="OpenSansSemibold" FontSize="24" />
                            <Label Text="Ejemplo procesado" Style="{StaticResource EcoSubtitle}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource EcoMetricCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="CO₂ EVITADO" TextColor="{StaticResource MutedText}" FontSize="10" />
                            <Label Text="91 kg" TextColor="{StaticResource PrimaryGreen}"
                                   FontFamily="OpenSansSemibold" FontSize="24" />
                            <Label Text="Valor ilustrativo" Style="{StaticResource EcoSubtitle}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource EcoMetricCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="ENTREGAS" TextColor="{StaticResource MutedText}" FontSize="10" />
                            <Label Text="12" TextColor="{StaticResource DeepTeal}"
                                   FontFamily="OpenSansSemibold" FontSize="24" />
                            <Label Text="Este mes" Style="{StaticResource EcoSubtitle}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource EcoMetricCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="EFICIENCIA" TextColor="{StaticResource MutedText}" FontSize="10" />
                            <Label Text="84%" TextColor="{StaticResource PrimaryGreen}"
                                   FontFamily="OpenSansSemibold" FontSize="24" />
                            <Label Text="Procesos demo" Style="{StaticResource EcoSubtitle}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource EcoCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Actividad de ejemplo" TextColor="{StaticResource DarkGreen}"
                               FontFamily="OpenSansSemibold" FontSize="18" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{StaticResource SoftGreen}"
                                    Stroke="Transparent" StrokeShape="RoundRectangle 14">
                                <Label Text="&#x267B;" FontSize="19" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Entrega orgánica" FontFamily="OpenSansSemibold" FontSize="14" />
                                <Label Text="Casa demostrativa • Sector Norte" Style="{StaticResource EcoSubtitle}" FontSize="11" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="18 kg" TextColor="{StaticResource PrimaryGreen}"
                                   FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource DividerSoft}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="42" HeightRequest="42" BackgroundColor="#E8F7F5"
                                    Stroke="Transparent" StrokeShape="RoundRectangle 14">
                                <Label Text="&#x2699;" FontSize="19" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Biodigestor activo" FontFamily="OpenSansSemibold" FontSize="14" />
                                <Label Text="Proceso demostrativo en curso" Style="{StaticResource EcoSubtitle}" FontSize="11" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" Style="{StaticResource StatusActivo}" VerticalOptions="Center">
                                <Label Text="ACTIVO" TextColor="{StaticResource DeepTeal}" FontSize="9" FontFamily="OpenSansSemibold" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource EcoCard}">
                    <VerticalStackLayout Spacing="9">
                        <Label Text="¿Quieres gestionar tu propia información?"
                               TextColor="{StaticResource DarkGreen}" FontFamily="OpenSansSemibold" FontSize="17" />
                        <Label Text="Crea una cuenta o inicia sesión para habilitar entregas, procesos, historial y reportes."
                               Style="{StaticResource EcoSubtitle}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" BackgroundColor="{StaticResource CardWhite}" Stroke="{StaticResource DividerSoft}"
                StrokeShape="RoundRectangle 22,22,0,0" Padding="18,12">
            <Button Text="Volver al inicio de sesión" Clicked="BackToLogin_Clicked"
                    Style="{StaticResource BotonSecundario}" HeightRequest="50" />
        </Border>
    </Grid>
</ContentPage>
